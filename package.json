{
  "name": "caulk",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "caulk": "./bin/caulk.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:cli": "esbuild src/cli/caulk.ts --bundle --platform=node --format=esm --outfile=bin/caulk.mjs --external:node:* && chmod +x bin/caulk.mjs",
    "caulk": "node bin/caulk.mjs",
    "pack": "npm run build && npm run build:cli && rm -f caulk-seohost.zip && (cd dist && zip -q -9 -r ../caulk-seohost.zip . -x 'api/config.php' -x 'api/_relay/*')",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:tasks": "esbuild test/tasks.test.ts --bundle --platform=node --format=esm --outfile=.tmp/tasks.test.mjs --external:node:* --log-level=warning && node .tmp/tasks.test.mjs",
    "test:activity": "esbuild test/activity.test.ts --bundle --platform=node --format=esm --outfile=.tmp/activity.test.mjs --external:node:* --log-level=warning && node .tmp/activity.test.mjs",
    "test:soundboard": "esbuild test/soundboard.test.ts --bundle --platform=node --format=esm --outfile=.tmp/soundboard.test.mjs --external:node:* --log-level=warning && node .tmp/soundboard.test.mjs",
    "test:ai": "esbuild test/ai.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/ai.test.mjs --log-level=warning && node .tmp/ai.test.mjs",
    "test:cli": "esbuild test/cli.test.ts --bundle --platform=node --format=esm --outfile=.tmp/cli.test.mjs --external:node:* --log-level=warning && node .tmp/cli.test.mjs",
    "test:sync": "esbuild test/sync.test.ts --bundle --platform=node --format=esm --outfile=.tmp/sync.test.mjs --external:node:* --log-level=warning && node .tmp/sync.test.mjs",
    "test:live": "esbuild test/live.test.ts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/live.test.mjs --log-level=warning && node .tmp/live.test.mjs",
    "test:navigation": "esbuild test/navigation.test.ts --bundle --platform=node --format=esm --outfile=.tmp/navigation.test.mjs --external:node:* --log-level=warning && node .tmp/navigation.test.mjs",
    "test:canvas": "esbuild test/infiniteCanvas.test.ts --bundle --platform=node --format=esm --outfile=.tmp/canvas.test.mjs --external:node:* --log-level=warning && node .tmp/canvas.test.mjs",
    "test": "npm run test:tasks && npm run test:activity && npm run test:soundboard && npm run test:ai && npm run test:cli && npm run test:sync && npm run test:live && npm run test:navigation && npm run test:canvas",
    "test:integration": "npm run test"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "lib0": "^0.2.120",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
